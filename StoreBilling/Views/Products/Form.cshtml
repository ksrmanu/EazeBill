@model StoreBilling.Data.Entities.Product
@{ ViewBag.Title = Model.Id == 0 ? "Add Product" : "Edit Product"; }
<div class="card-modern" style="max-width: 100%;">
    @using (Html.BeginForm(Model.Id == 0 ? "Create" : "Edit", "Products", FormMethod.Post))
    {
        @Html.AntiForgeryToken() @Html.HiddenFor(m => m.Id)
        <h5 class="mb-3">@ViewBag.Title</h5>
        <div class="row mb-3">
            <div class="col-md-6"><label class="fw-bold">Code</label>@Html.TextBoxFor(m => m.Code, new { @class = "form-control", required = "required" })</div>
            <div class="col-md-6"><label class="fw-bold">Name</label>@Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required" })</div>
        </div>
        <div class="row mb-3">
            <div class="col-md-4"><label class="fw-bold">Selling Rate</label>@Html.TextBoxFor(m => m.SellingRate, new { @class = "form-control", type = "number", step = "0.01" })</div>
            <div class="col-md-4"><label class="fw-bold">MRP</label>@Html.TextBoxFor(m => m.MRP, new { @class = "form-control", type = "number", step = "0.01" })</div>
            <div class="col-md-4"><label class="fw-bold">Opening Stock</label>@Html.TextBoxFor(m => m.OpeningStock, new { @class = "form-control", type = "number", step = "0.01" })</div>
        </div>
        <div class="mb-3 form-check">
            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" }) <label class="form-check-label">Is Active</label>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/Products" class="btn btn-secondary">Back</a>
    }
</div>