@model StoreBilling.Data.Entities.Customer
@{ ViewBag.Title = Model.Id == 0 ? "Add Customer" : "Edit Customer"; }
<div class="card" style="max-width: 800px;">
    @using (Html.BeginForm(Model.Id == 0 ? "Create" : "Edit", "Customers", FormMethod.Post))
    {
        @Html.HiddenFor(m => m.Id)
        <h5 class="mb-3">@ViewBag.Title</h5>
        <div class="row mb-3">
            <div class="col-md-6"><label class="fw-bold">Code</label>@Html.TextBoxFor(m => m.Code, new { @class = "form-control", required = "required" })</div>
            <div class="col-md-6"><label class="fw-bold">Name</label>@Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required" })</div>
        </div>
        <div class="row mb-3">
            <div class="col-md-6"><label class="fw-bold">Mobile</label>@Html.TextBoxFor(m => m.Mobile, new { @class = "form-control" })</div>
            <div class="col-md-6"><label class="fw-bold">Address</label>@Html.TextBoxFor(m => m.Address, new { @class = "form-control" })</div>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/Customers" class="btn btn-secondary">Back</a>
    }
</div>