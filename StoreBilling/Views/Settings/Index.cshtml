
@model StoreBilling.Models.ViewModels.SettingsViewModel
@{ ViewBag.Title = "System Settings"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="fa-solid fa-gear text-primary me-2"></i>Settings</h4>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="fa-solid fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card-modern p-0">
    <div class="row g-0">
        <!-- Settings Navigation -->
        <div class="col-md-3 border-end bg-light rounded-start" style="min-height: 400px;">
            <div class="nav flex-column nav-pills p-3" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                <button class="nav-link active text-start fw-bold mb-1" id="tab-store" data-bs-toggle="pill" data-bs-target="#content-store" type="button" role="tab">
                    <i class="fa-solid fa-store me-2"></i> Store Profile
                </button>
                <button class="nav-link text-start fw-bold mb-1" id="tab-invoice" data-bs-toggle="pill" data-bs-target="#content-invoice" type="button" role="tab">
                    <i class="fa-solid fa-file-invoice me-2"></i> Invoice & Billing
                </button>
                <button class="nav-link text-start fw-bold" id="tab-system" data-bs-toggle="pill" data-bs-target="#content-system" type="button" role="tab">
                    <i class="fa-solid fa-server me-2"></i> System Preferences
                </button>
            </div>
        </div>

        <!-- Settings Content -->
        <div class="col-md-9 p-4">
            @using (Html.BeginForm("Index", "Settings", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="tab-content" id="v-pills-tabContent">

                    <!-- Store Profile Tab -->
                    <div class="tab-pane fade show active" id="content-store" role="tabpanel">
                        <h5 class="fw-bold mb-4 border-bottom pb-2">Store Profile</h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="fw-bold small">Store Name</label>
                                @Html.TextBoxFor(m => m.StoreName, new { @class = "form-control", placeholder = "e.g. SwiftBill Retail" })
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold small">Phone Number</label>
                                @Html.TextBoxFor(m => m.StorePhone, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold small">Address</label>
                            @Html.TextBoxFor(m => m.StoreAddress, new { @class = "form-control" })
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold small">GST Number</label>
                            @Html.TextBoxFor(m => m.StoreGST, new { @class = "form-control" })
                        </div>
                    </div>

                    <!-- Invoice Tab -->
                    <div class="tab-pane fade" id="content-invoice" role="tabpanel">
                        <h5 class="fw-bold mb-4 border-bottom pb-2">Invoice Settings</h5>
                        <div class="mb-3">
                            <label class="fw-bold small">Invoice Number Prefix</label>
                            @Html.TextBoxFor(m => m.InvoicePrefix, new { @class = "form-control", placeholder = "e.g. INV-" })
                            <small class="text-muted">This will be added before the invoice number (e.g. INV-1001)</small>
                        </div>
                    </div>

                    <!-- System Tab -->
                    <div class="tab-pane fade" id="content-system" role="tabpanel">
                        <h5 class="fw-bold mb-4 border-bottom pb-2">System Preferences</h5>
                        <div class="form-check form-switch fs-5 mb-3">
                            @Html.CheckBoxFor(m => m.AllowNegativeStock, new { @class = "form-check-input" })
                            <label class="form-check-label fw-bold ms-2 fs-6">Allow Negative Stock (Overselling)</label>
                            <br />
                            <small class="text-muted">If enabled, the POS will allow you to sell items even if the stock is 0.</small>
                        </div>
                    </div>

                </div>

                <div class="mt-5 border-top pt-4">
                    <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-floppy-disk me-2"></i> Save Settings</button>
                </div>
            }
        </div>
    </div>
</div>