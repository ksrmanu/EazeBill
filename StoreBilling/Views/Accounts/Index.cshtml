@model StoreBilling.Models.ViewModels.AccountsViewModel
@{ ViewBag.Title = "Accounts & Finance"; }

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card-modern p-4" style="border-left: 4px solid #10b981;">
            <h6 class="text-muted fw-bold mb-1">Total Receipts (In)</h6>
            <h3 class="fw-bold text-success mb-0">₹@Model.TotalReceipts.ToString("N2")</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-modern p-4" style="border-left: 4px solid #ef4444;">
            <h6 class="text-muted fw-bold mb-1">Total Payments (Out)</h6>
            <h3 class="fw-bold text-danger mb-0">₹@Model.TotalPayments.ToString("N2")</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-modern p-4" style="border-left: 4px solid #f97316;">
            <h6 class="text-muted fw-bold mb-1">Total Expenses</h6>
            <h3 class="fw-bold text-warning mb-0">₹@Model.TotalExpenses.ToString("N2")</h3>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Add Transaction Form -->
    <div class="col-md-4">
        <div class="card-modern p-0">
            <ul class="nav nav-tabs nav-fill" id="accTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active fw-bold" data-bs-toggle="tab" data-bs-target="#receiptTab">Receipt</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#paymentTab">Payment</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#expenseTab">Expense</button>
                </li>
            </ul>
            <div class="tab-content p-4">

                <!-- Receipt Form -->
                <div class="tab-pane fade show active" id="receiptTab">
                    <form id="formReceipt">
                        <div class="mb-3"><label class="fw-bold small">Customer Name</label><input type="text" name="CustomerName" class="form-control" required /></div>
                        <div class="mb-3"><label class="fw-bold small">Amount (₹)</label><input type="number" step="0.01" name="Amount" class="form-control" required /></div>
                        <div class="mb-3">
                            <label class="fw-bold small">Payment Mode</label>
                            <select name="PaymentMode" class="form-select"><option>Cash</option><option>UPI</option><option>Card</option></select>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Save Receipt</button>
                    </form>
                </div>

                <!-- Payment Form -->
                <div class="tab-pane fade" id="paymentTab">
                    <form id="formPayment">
                        <div class="mb-3"><label class="fw-bold small">Supplier Name</label><input type="text" name="SupplierName" class="form-control" required /></div>
                        <div class="mb-3"><label class="fw-bold small">Amount (₹)</label><input type="number" step="0.01" name="Amount" class="form-control" required /></div>
                        <div class="mb-3">
                            <label class="fw-bold small">Payment Mode</label>
                            <select name="PaymentMode" class="form-select"><option>Cash</option><option>Bank</option><option>UPI</option></select>
                        </div>
                        <button type="submit" class="btn btn-danger w-100">Save Payment</button>
                    </form>
                </div>

                <!-- Expense Form -->
                <div class="tab-pane fade" id="expenseTab">
                    <form id="formExpense">
                        <div class="mb-3">
                            <label class="fw-bold small">Category</label>
                            <select name="Category" class="form-select">
                                <option>Rent</option>
                                <option>Electricity</option>
                                <option>Salary</option>
                                <option>Transport</option>
                                <option>Maintenance</option>
                                <option>Miscellaneous</option>
                            </select>
                        </div>
                        <div class="mb-3"><label class="fw-bold small">Description</label><input type="text" name="Description" class="form-control" required /></div>
                        <div class="mb-3"><label class="fw-bold small">Amount (₹)</label><input type="number" step="0.01" name="Amount" class="form-control" required /></div>
                        <button type="submit" class="btn btn-warning w-100">Save Expense</button>
                    </form>
                </div>

            </div>
        </div>
    </div>

    <!-- Cash Book / Ledger -->
    <div class="col-md-8">
        <div class="card-modern h-100">
            <h5 class="fw-bold mb-4">Day Book (Recent Transactions)</h5>
            <div class="table-responsive">
                <table class="table table-modern mb-0">
                    <thead>
                        <tr><th>Date</th><th>Description</th><th>Type</th><th class="text-end">Amount</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Transactions.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-5">No transactions found.</td></tr>
                        }
                        @foreach (var txn in Model.Transactions)
                        {
                            <tr>
                                <td>@txn.Date.ToString("dd MMM yyyy")</td>
                                <td class="fw-bold">@txn.Description</td>
                                <td>
                                    @if (txn.Type == "Receipt")
                                    {<span class="badge bg-success">In</span> }
                                    else if (txn.Type == "Payment")
                                    { <span class="badge bg-danger">Out</span> }
                                    else
                                    { <span class="badge bg-warning text-dark">Expense</span>}
                                </td>
                                <td class="text-end fw-bold @(txn.Amount < 0 ? "text-danger" : "text-success")">
                                    @(txn.Amount < 0 ? "-" : "+") ₹@Math.Abs(txn.Amount).ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>// Handle AJAX Form Submissions
    function handleForm(formId, url) {
        $(formId).submit(function (e) {
            e.preventDefault();
            $.post(url, $(this).serialize(), function (res) {
                if (res.success) {
                    Swal.fire('Success', res.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            });
        });
    }
    handleForm('#formReceipt', '/Accounts/AddReceipt');
    handleForm('#formPayment', '/Accounts/AddPayment');
    handleForm('#formExpense', '/Accounts/AddExpense');</script>
}