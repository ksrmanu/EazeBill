
@model StoreBilling.Data.Entities.SalesInvoice
@{
    Layout = null;
    var items = (List<StoreBilling.Data.Entities.SalesInvoiceItem>)ViewBag.Items;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Invoice - @Model.InvoiceNo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #f1f5f9;
            padding: 40px;
            font-family: 'Segoe UI', sans-serif;
        }

        .invoice-box {
            background: #fff;
            max-width: 800px;
            margin: 0 auto;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .invoice-header {
            border-bottom: 2px solid #10b981;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }

        .brand {
            font-size: 2rem;
            font-weight: 800;
            color: #10b981;
        }

        .table-invoice th {
            background: #f8fafc;
            text-transform: uppercase;
            font-size: 0.8rem;
            color: #64748b;
        }

        .total-row {
            font-size: 1.2rem;
            font-weight: bold;
            background: #ecfdf5;
            color: #047857;
        }

        @@media print {
            body {
                background: #fff;
                padding: 0;
            }

            .invoice-box {
                box-shadow: none;
                padding: 0;
            }

            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="text-end no-print mb-3" style="max-width: 800px; margin: 0 auto;">
        <button class="btn btn-primary" onclick="window.print()"><i class="fa-solid fa-print"></i> Print / Save PDF</button>
        <button class="btn btn-secondary" onclick="window.close()">Close</button>
    </div>

    <div class="invoice-box">
        <div class="row invoice-header">
            <div class="col-6">
                <div class="brand">SwiftBill</div>
                <div class="text-muted">123 Market Road, City</div>
                <div class="text-muted">Phone: 9876543210</div>
                <div class="text-muted">GST: 29ABCDE1234F1Z5</div>
            </div>
            <div class="col-6 text-end">
                <h4 class="fw-bold mb-1">TAX INVOICE</h4>
                <div class="text-muted">Invoice No: <strong>@Model.InvoiceNo</strong></div>
                <div class="text-muted">Date: @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-6">
                <h6 class="fw-bold text-muted">BILL TO:</h6>
                <h5 class="fw-bold">@(string.IsNullOrEmpty(Model.CustomerName) ? "Walk-in Customer" : Model.CustomerName)</h5>
            </div>
            <div class="col-6 text-end">
                <div class="text-muted">Payment Mode: <strong>@Model.PaymentMethod</strong></div>
                <div class="text-muted">Status: <strong>@Model.Status</strong></div>
            </div>
        </div>

        <table class="table table-bordered table-invoice mb-4">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Product Description</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Rate</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var item in items)
                {
                    <tr>
                        <td>@i</td>
                        <td>@item.Product.Name</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">₹@item.Rate.ToString("N2")</td>
                        <td class="text-end">₹@item.Total.ToString("N2")</td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>

        <div class="row justify-content-end">
            <div class="col-md-5">
                <table class="table table-sm">
                    <tr><td class="text-muted">Subtotal:</td><td class="text-end">₹@Model.SubTotal.ToString("N2")</td></tr>
                    <tr><td class="text-muted">Tax (GST):</td><td class="text-end">₹@Model.TaxAmount.ToString("N2")</td></tr>
                    <tr class="total-row">
                        <td>Grand Total:</td>
                        <td class="text-end">₹@Model.GrandTotal.ToString("N2")</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="text-center text-muted mt-5 pt-4 border-top">
            <small>Thank you for your business! For any queries, contact support@swiftbill.com</small>
        </div>
    </div>

</body>
</html>