@{ ViewBag.Title = "Sales Register"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold"><i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>Sales Register</h4>
        <p class="text-muted small mb-0">View all past invoices and print receipts.</p>
    </div>
    <a href="/POS" class="btn btn-primary"><i class="fa-solid fa-cash-register me-2"></i>New Sale (POS)</a>
</div>

<div class="card-modern">
    <div class="row mb-4">
        <div class="col-md-3">
            <label class="fw-bold small text-muted">From Date</label>
            <input type="date" id="startDate" class="form-control" value="@DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="fw-bold small text-muted">To Date</label>
            <input type="date" id="endDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-outline-primary w-100" onclick="loadData()"><i class="fa-solid fa-filter"></i> Filter</button>
        </div>
    </div>

    <div class="table-responsive">
        <table id="tblSales" class="table table-modern w-100 align-middle">
            <thead>
                <tr>
                    <th>Invoice No</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Payment</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>let table;

        $(function () {
            table = $('#tblSales').DataTable({
                ajax: {
                    url: '/Sales/GetList',
                    data: function (d) {
                        d.startDate = $('#startDate').val();
                        d.endDate = $('#endDate').val();
                    }
                },
                columns: [
                    { data: 'InvoiceNo', className: 'fw-bold text-primary' },
                    { data: 'Date', render: d => new Date(parseInt(d.substr(6))).toLocaleString() },
                    { data: 'CustomerName' },
                    { data: 'PaymentMethod', render: d => `<span class="badge bg-light text-dark border">${d}</span>` },
                    { data: 'GrandTotal', className: 'fw-bold', render: $.fn.dataTable.render.number(',', '.', 2, '₹') },
                    {
                        data: 'Status',
                        render: d => d === 'Paid' ? '<span class="badge bg-success">Paid</span>' : '<span class="badge bg-warning text-dark">Partial</span>'
                    },
                    {
                        data: 'Id', // Ensures the ID from the database is passed
                        className: 'text-end',
                        orderable: false,
                        render: function (data, type, row) {
                            // data contains the Id
                            return `<a href="/Sales/Print/${data}" target="_blank" class="btn btn-sm btn-outline-primary" title="Print Invoice"><i class="fa-solid fa-print"></i> Print</a>`;
                        }
                    }
                ]
            });
        });

        function loadData() {
            table.ajax.reload();
        }</script>
}
